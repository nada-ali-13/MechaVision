{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MechaVision offline Arduino catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parts", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "projects": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/project"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "pin": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_+-]*$"},
    "endpoint": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[A-Z0-9][A-Z0-9_+-]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number", "exclusiveMinimum": 0},
        "y": {"type": "number", "exclusiveMinimum": 0},
        "z": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "purpose"],
        "properties": {
          "url": {"type": "string", "pattern": "^https://[^\\s/]+(/[^\\s]*)?$"},
          "purpose": {"$ref": "#/$defs/text"},
          "accessed_on": {"type": "string", "format": "date"}
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_ar", "name_en", "geometry", "size_m", "pins", "sources"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name_ar": {"$ref": "#/$defs/text"},
        "name_en": {"$ref": "#/$defs/text"},
        "geometry": {"$ref": "#/$defs/id"},
        "size_m": {"$ref": "#/$defs/size"},
        "sources": {"$ref": "#/$defs/sources"},
        "pins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "position_m"],
            "properties": {"id": {"$ref": "#/$defs/pin"}, "position_m": {"$ref": "#/$defs/point"}}
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "part_id", "qty", "placement", "position_m"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "part_id": {"$ref": "#/$defs/id"},
        "qty": {"const": 1},
        "placement": {"enum": ["breadboard", "outside_board"]},
        "position_m": {"$ref": "#/$defs/point"}
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "color"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/endpoint"},
        "to": {"$ref": "#/$defs/endpoint"},
        "kind": {"enum": ["power", "ground", "signal"]},
        "color": {"enum": ["red", "black", "yellow"]}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "connection_ids", "instruction_ar"],
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "connection_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "instruction_ar": {"$ref": "#/$defs/text"}
      }
    },
    "electrical_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supply_notes_ar", "warnings_ar"],
      "properties": {
        "supply_notes_ar": {"$ref": "#/$defs/text"},
        "warnings_ar": {"$ref": "#/$defs/instructions"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_board", "breadboard_size_m", "hole_pitch_m"],
      "properties": {
        "reference_board": {"const": "breadboard_830"},
        "breadboard_size_m": {"$ref": "#/$defs/size"},
        "hole_pitch_m": {"const": 0.00254}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "pin_reviewed", "power_reviewed", "code_compiled", "hardware_tested", "ar_layout_reviewed", "status"],
      "properties": {
        "schema_valid": {"type": "boolean"},
        "pin_reviewed": {"type": "boolean"},
        "power_reviewed": {"type": "boolean"},
        "code_compiled": {"type": "boolean"},
        "hardware_tested": {"type": "boolean"},
        "ar_layout_reviewed": {"type": "boolean"},
        "status": {"enum": ["draft", "verified"]}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name_ar", "name_en", "description_ar", "aliases", "category", "level",
        "learning_objectives", "board", "components", "connections", "assembly_steps",
        "sketch_path", "sketch_resource", "required_libraries", "electrical_constraints", "layout",
        "sources", "verification"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name_ar": {"$ref": "#/$defs/text"},
        "name_en": {"$ref": "#/$defs/text"},
        "description_ar": {"$ref": "#/$defs/text"},
        "aliases": {"$ref": "#/$defs/texts"},
        "category": {"$ref": "#/$defs/id"},
        "level": {"enum": ["beginner", "intermediate", "advanced"]},
        "learning_objectives": {"$ref": "#/$defs/instructions"},
        "board": {"const": "arduino:avr:uno"},
        "components": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/component"}},
        "connections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/wire"}},
        "assembly_steps": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/step"}},
        "sketch_path": {"type": "string", "pattern": "^ArduinoProjects/[a-z0-9_]+/[a-z0-9_]+\\.ino$"},
        "sketch_resource": {"type": "string", "pattern": "^MechaVision/Sketches/[a-z0-9_]+$"},
        "required_libraries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"$ref": "#/$defs/text"},
              "version": {"$ref": "#/$defs/text"}
            }
          }
        },
        "electrical_constraints": {"$ref": "#/$defs/electrical_constraints"},
        "layout": {"$ref": "#/$defs/layout"},
        "sources": {"$ref": "#/$defs/sources"},
        "verification": {"$ref": "#/$defs/verification"}
      }
    }
  }
}
